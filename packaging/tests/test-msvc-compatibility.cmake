# Exercise the real package template without requiring an MSVC installation.
# These are configure-time policy checks; windows-v142 tests actual linking.
cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED TEST_BINARY_DIR)
    message(FATAL_ERROR "Pass -DTEST_BINARY_DIR=<temporary-directory>")
endif()
file(MAKE_DIRECTORY "${TEST_BINARY_DIR}")
file(WRITE "${TEST_BINARY_DIR}/FreeImageTargets.cmake" "set(_fi_targets_loaded TRUE)\n")
set(PACKAGE_INIT "")
file(WRITE "${TEST_BINARY_DIR}/FreeImageCodecs.cmake" "")
set(BUILD_LIBJXL OFF)
set(USE_SYSTEM_LIBJXL OFF)
set(BUILD_LIBHEIF OFF)
set(USE_SYSTEM_LIBHEIF OFF)
set(BUILD_LIBJPEG ON)
set(USE_SYSTEM_LIBJPEG OFF)
set(USE_LIBJPEG_TURBO OFF)

function(check_package name producer_id producer_version is_static consumer_id consumer_version language expected)
    set(CMAKE_CXX_COMPILER_ID "${producer_id}")
    set(CMAKE_CXX_COMPILER_VERSION "${producer_version}")
    set(FREEIMAGE_STATIC "${is_static}")
    configure_file("${CMAKE_CURRENT_LIST_DIR}/../../cmake/FreeImageConfig.cmake.in"
        "${TEST_BINARY_DIR}/FreeImageConfig.cmake" @ONLY)
    # Clear the producer values to model an independent consumer project.
    unset(CMAKE_CXX_COMPILER_ID)
    unset(CMAKE_CXX_COMPILER_VERSION)
    set(CMAKE_${language}_COMPILER_ID "${consumer_id}")
    set(CMAKE_${language}_COMPILER_VERSION "${consumer_version}")
    # A C++ consumer may independently select an older C compiler: the
    # final C++ toolchain, rather than every enabled language, is relevant.
    if(language STREQUAL "CXX")
        set(CMAKE_C_COMPILER_ID MSVC)
        set(CMAKE_C_COMPILER_VERSION 19.16.27023)
    endif()
    set(_fi_targets_loaded FALSE)
    find_package(FreeImage QUIET CONFIG PATHS "${TEST_BINARY_DIR}" NO_DEFAULT_PATH)
    if(expected)
        if(NOT FreeImage_FOUND OR NOT _fi_targets_loaded)
            message(FATAL_ERROR "${name}: compatible package was rejected")
        endif()
    else()
        if(FreeImage_FOUND OR _fi_targets_loaded)
            message(FATAL_ERROR "${name}: incompatible static package was accepted")
        endif()
        if(NOT FreeImage_NOT_FOUND_MESSAGE MATCHES "${producer_version}"
           OR NOT FreeImage_NOT_FOUND_MESSAGE MATCHES "vs2022-v142")
            message(FATAL_ERROR "${name}: missing producer version or repair instructions")
        endif()
    endif()
    message(STATUS "${name}: passed")
endfunction()

check_package(v143_to_v142 MSVC 19.44.35207 ON MSVC 19.29.30159 CXX FALSE)
check_package(v143_to_older_v143 MSVC 19.44.35207 ON MSVC 19.38.33130 CXX FALSE)
check_package(older_patch MSVC 19.44.35207 ON MSVC 19.44.35206 CXX FALSE)
check_package(c_only_consumer MSVC 19.44.35207 ON MSVC 19.29.30159 C FALSE)
check_package(same_compiler MSVC 19.29.30159 ON MSVC 19.29.30159 CXX TRUE)
check_package(v142_to_v143 MSVC 19.29.30159 ON MSVC 19.44.35207 CXX TRUE)
check_package(shared_package MSVC 19.44.35207 OFF MSVC 19.29.30159 CXX TRUE)
check_package(clang_consumer MSVC 19.44.35207 ON Clang 19.1.0 CXX TRUE)
check_package(clang_producer Clang 19.1.0 ON MSVC 19.29.30159 CXX TRUE)
