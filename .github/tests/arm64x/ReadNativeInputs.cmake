# The native response file is produced by /LINKREPROFULLPATHRSP (VS 17.11+).
# Keep linker inputs, not native /OUT, /MACHINE, PDB or resource settings.
function(arm64x_read_native_inputs response objects libraries definition)
    if(NOT EXISTS "${response}")
        message(FATAL_ERROR "Build the ARM64 stage first; missing response file: ${response}")
    endif()
    # MSVC can emit UTF-16 response files. STRINGS recognizes Unicode BOMs
    # and decodes the lines; READ leaves NUL bytes in the command string.
    file(STRINGS "${response}" response_lines)
    list(JOIN response_lines "\n" contents)
    separate_arguments(arguments WINDOWS_COMMAND "${contents}")
    set(native_objects)
    set(native_libraries)
    set(native_definition)
    foreach(argument IN LISTS arguments)
        string(TOLOWER "${argument}" lower)
        if(lower MATCHES "^/def:")
            string(SUBSTRING "${argument}" 5 -1 native_definition)
        elseif(lower MATCHES "^[-/][a-z][a-z0-9_-]*:")
            continue()
        elseif(lower MATCHES "\\.obj$")
            list(APPEND native_objects "${argument}")
        elseif(lower MATCHES "\\.lib$")
            list(APPEND native_libraries "${argument}")
        endif()
    endforeach()
    if(NOT native_objects)
        message(FATAL_ERROR "No native ARM64 objects found in ${response}")
    endif()
    foreach(input IN LISTS native_objects native_libraries native_definition)
        if(NOT IS_ABSOLUTE "${input}" OR NOT EXISTS "${input}")
            message(FATAL_ERROR "Expected an existing absolute native linker input: ${input}")
        endif()
    endforeach()
    set(${objects} "${native_objects}" PARENT_SCOPE)
    set(${libraries} "${native_libraries}" PARENT_SCOPE)
    set(${definition} "${native_definition}" PARENT_SCOPE)
endfunction()
