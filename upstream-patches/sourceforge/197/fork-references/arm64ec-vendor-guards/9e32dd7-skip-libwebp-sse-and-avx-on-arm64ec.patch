 #define WEBP_MSC_SSE41  // Visual C++ SSE4.1 targets
 #endif
 
 #if defined(_MSC_VER) && _MSC_VER >= 1700 && \
-    (defined(_M_X64) || defined(_M_IX86))
+    (defined(_M_X64) || defined(_M_IX86)) && !defined(_M_ARM64EC)
 #define WEBP_MSC_AVX2  // Visual C++ AVX2 targets
