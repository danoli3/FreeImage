+      __m128 ft_min = _mm_set1_ps(rec->ft_min);
+      __m128 ft_max = _mm_set1_ps(rec->ft_max);
+      __m128 fd_min = _mm_set1_ps(rec->fd_min);
+      __m128 delta = _mm_set1_ps(rec->delta);
+      __m128 inv_delta = _mm_set1_ps(rec->inv_delta);
