cmake_minimum_required(VERSION 3.21)
if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "Visual Studio builds require a Windows host")
endif()
if(NOT FREEIMAGE_VS_PLATFORM MATCHES "^(Win32|x64|ARM64|ARM64EC)$")
    message(FATAL_ERROR "Unsupported Visual Studio platform: ${FREEIMAGE_VS_PLATFORM}")
endif()
if(NOT FREEIMAGE_VS_ACTION MATCHES "^(build|rebuild|clean)$")
    message(FATAL_ERROR "Unsupported build action: ${FREEIMAGE_VS_ACTION}")
endif()
get_filename_component(source_dir "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
get_filename_component(project_dir "${FREEIMAGE_VS_PROJECT_DIR}" REALPATH)
include("${project_dir}/FreeImageOptions.cmake")
# A moved/shared source tree receives a fresh cache for its location and host.
# This also separates caches when a network path is identical on two machines.
cmake_host_system_information(RESULT host QUERY HOSTNAME)
string(SHA256 location "${source_dir};${project_dir};${host}")
string(SUBSTRING "${location}" 0 12 location)
set(build_dir "${project_dir}/cache/${FREEIMAGE_VS_PLATFORM}/${location}")
set(output_dir "${project_dir}/artifacts/${FREEIMAGE_VS_PLATFORM}")
function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Visual Studio ${FREEIMAGE_VS_PLATFORM} ${FREEIMAGE_VS_ACTION} failed: ${result}")
    endif()
endfunction()
if(FREEIMAGE_VS_ACTION STREQUAL "clean")
    if(EXISTS "${build_dir}/CMakeCache.txt")
        run("${CMAKE_COMMAND}" --build "${build_dir}" --config "${FREEIMAGE_VS_CONFIG}" --target clean)
    endif()
    return()
endif()
set(toolset)
if(FREEIMAGE_VS_TOOLSET)
    set(toolset -T "${FREEIMAGE_VS_TOOLSET}")
endif()
run("${CMAKE_COMMAND}" -S "${source_dir}" -B "${build_dir}"
    -G "${FREEIMAGE_VS_GENERATOR}" -A "${FREEIMAGE_VS_PLATFORM}" ${toolset}
    -C "${project_dir}/FreeImageOptions.cmake"
    "-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY:PATH=${output_dir}"
    "-DCMAKE_LIBRARY_OUTPUT_DIRECTORY:PATH=${output_dir}"
    "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY:PATH=${output_dir}")
set(clean_first)
if(FREEIMAGE_VS_ACTION STREQUAL "rebuild")
    set(clean_first --clean-first)
endif()
set(jobs "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
if(jobs STREQUAL "")
    include(ProcessorCount)
    ProcessorCount(jobs)
    if(jobs EQUAL 0)
        set(jobs 1)
    endif()
endif()
if(NOT jobs MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "CMAKE_BUILD_PARALLEL_LEVEL must be a positive integer")
endif()
run("${CMAKE_COMMAND}" --build "${build_dir}" --config "${FREEIMAGE_VS_CONFIG}"
    --parallel "${jobs}" ${clean_first})
