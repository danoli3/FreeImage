# A relocatable IDE front end. CMake's own generated projects and caches remain
# architecture-specific; the IDE projects below select the correct build tree.
function(freeimage_generate_visual_studio_solution output_dir vs_generator)
    set(platforms x64 Win32 ARM64 ARM64EC)
    set(configurations ${CMAKE_CONFIGURATION_TYPES})
    if(NOT configurations)
        set(configurations Debug Release)
    endif()
    if(NOT vs_generator MATCHES "^Visual Studio (17|18) ")
        message(FATAL_ERROR "The combined solution requires a Visual Studio generator")
    endif()
    set(vs_major "${CMAKE_MATCH_1}")
    set(vs_toolset "${CMAKE_VS_PLATFORM_TOOLSET}")
    if(NOT vs_toolset)
        if(vs_major GREATER_EQUAL 18)
            set(vs_toolset v145)
        else()
            set(vs_toolset v143)
        endif()
    endif()
    file(MAKE_DIRECTORY "${output_dir}")
    file(RELATIVE_PATH source_relative "${output_dir}" "${PROJECT_SOURCE_DIR}")
    if(IS_ABSOLUTE "${source_relative}")
        message(FATAL_ERROR "The portable solution and source tree must be on the same drive")
    endif()
    string(REPLACE "/" "\\" source_relative "${source_relative}")
    string(APPEND source_relative "\\")

    # Copy feature settings, not host/compiler/SDK paths, to the new builds.
    set(settings "# Generated FreeImage feature settings.\n")
    string(APPEND settings "set(FREEIMAGE_VS_GENERATOR [==[${vs_generator}]==])\n")
    string(APPEND settings "set(FREEIMAGE_VS_TOOLSET [==[${CMAKE_GENERATOR_TOOLSET}]==])\n")
    get_cmake_property(cache_variables CACHE_VARIABLES)
    foreach(variable IN LISTS cache_variables)
        get_property(type CACHE "${variable}" PROPERTY TYPE)
        if((variable MATCHES "^(BUILD_|USE_SYSTEM_|FREEIMAGE_)" AND
            (type STREQUAL "BOOL" OR type STREQUAL "STRING")) OR
           variable MATCHES "^CMAKE_(C|CXX)_STANDARD(_REQUIRED|_EXTENSIONS)?$")
            if(variable STREQUAL "FREEIMAGE_VS_ALL_PLATFORMS")
                continue()
            endif()
            if(type STREQUAL "UNINITIALIZED")
                set(type STRING)
            endif()
            string(APPEND settings "set(${variable} [==[${${variable}}]==] CACHE ${type} \"\" FORCE)\n")
        endif()
    endforeach()
    string(APPEND settings "set(FREEIMAGE_VS_ALL_PLATFORMS OFF CACHE BOOL \"\" FORCE)\n")
    file(WRITE "${output_dir}/FreeImageOptions.cmake" "${settings}")

    # Include only source-tree paths in the portable IDE project. Generated
    # headers/resources are produced separately inside each architecture cache.
    get_target_property(sources FreeImage SOURCES)
    set(project_items "")
    foreach(source IN LISTS sources)
        if(source MATCHES "\\$<")
            continue()
        endif()
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
        file(RELATIVE_PATH generated "${PROJECT_BINARY_DIR}" "${source}")
        if(NOT generated MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${generated}")
            continue()
        endif()
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${source}")
        if(relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${relative}")
            continue()
        endif()
        string(REPLACE "/" "\\" relative "${relative}")
        string(REPLACE "&" "&amp;" relative "${relative}")
        if(relative MATCHES "\\.(c|cc|cpp|cxx)$")
            set(kind ClCompile)
        elseif(relative MATCHES "\\.(h|hpp|hxx|inl)$")
            set(kind ClInclude)
        else()
            set(kind None)
        endif()
        string(APPEND project_items "    <${kind} Include=\"$(FreeImageSourceDir)${relative}\" />\n")
    endforeach()
    get_directory_property(include_dirs INCLUDE_DIRECTORIES)
    set(project_includes "$(FreeImageSourceDir)Source")
    foreach(directory IN LISTS include_dirs)
        if(directory MATCHES "\\$<")
            continue()
        endif()
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${directory}")
        if(NOT relative MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${relative}")
            string(REPLACE "/" "\\" relative "${relative}")
            string(APPEND project_includes ";$(FreeImageSourceDir)${relative}")
        endif()
    endforeach()
    get_directory_property(definitions COMPILE_DEFINITIONS)
    get_target_property(target_definitions FreeImage COMPILE_DEFINITIONS)
    if(target_definitions)
        list(APPEND definitions ${target_definitions})
    endif()
    list(FILTER definitions EXCLUDE REGEX "\\$<")
    list(REMOVE_DUPLICATES definitions)
    list(JOIN definitions ";" project_definitions)
    if(FREEIMAGE_STATIC)
        set(artifact FreeImage.lib)
    else()
        set(artifact FreeImage.dll)
    endif()

    # XML escaping also covers paths containing spaces and ampersands.
    foreach(variable source_relative project_items project_includes project_definitions)
        if(NOT variable STREQUAL "project_items")
            string(REPLACE "&" "&amp;" ${variable} "${${variable}}")
            string(REPLACE "<" "&lt;" ${variable} "${${variable}}")
            string(REPLACE ">" "&gt;" ${variable} "${${variable}}")
            string(REPLACE "\"" "&quot;" ${variable} "${${variable}}")
        endif()
    endforeach()
    set(solution "Microsoft Visual Studio Solution File, Format Version 12.00\n# Visual Studio Version ${vs_major}\n")
    set(solution_mappings "")
    foreach(platform IN LISTS platforms)
        string(UUID project_guid NAMESPACE "92c4eeb2-d789-4caa-846c-571bdb906717"
            NAME "FreeImage-${platform}" TYPE SHA1 UPPER)
        set(project_configurations "")
        foreach(config IN LISTS configurations)
            string(APPEND project_configurations
                "    <ProjectConfiguration Include=\"${config}|${platform}\"><Configuration>${config}</Configuration><Platform>${platform}</Platform></ProjectConfiguration>\n")
        endforeach()
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/VisualStudioProject.vcxproj.in"
            "${output_dir}/FreeImage-${platform}.vcxproj" @ONLY)
        string(APPEND solution "Project(\"{8BC9CEB8-8B4A-11D0-8D11-00A0C91BC942}\") = \"FreeImage-${platform}\", \"FreeImage-${platform}.vcxproj\", \"{${project_guid}}\"\nEndProject\n")
        foreach(selection IN ITEMS ${platforms} "All Platforms")
            foreach(config IN LISTS configurations)
                string(APPEND solution_mappings "\t\t{${project_guid}}.${config}|${selection}.ActiveCfg = ${config}|${platform}\n")
                if(selection STREQUAL platform OR selection STREQUAL "All Platforms")
                    string(APPEND solution_mappings "\t\t{${project_guid}}.${config}|${selection}.Build.0 = ${config}|${platform}\n")
                endif()
            endforeach()
        endforeach()
    endforeach()
    string(APPEND solution "Global\n\tGlobalSection(SolutionConfigurationPlatforms) = preSolution\n")
    foreach(selection IN ITEMS ${platforms} "All Platforms")
        foreach(config IN LISTS configurations)
            string(APPEND solution "\t\t${config}|${selection} = ${config}|${selection}\n")
        endforeach()
    endforeach()
    string(APPEND solution "\tEndGlobalSection\n\tGlobalSection(ProjectConfigurationPlatforms) = postSolution\n${solution_mappings}\tEndGlobalSection\nEndGlobal\n")
    file(WRITE "${output_dir}/FreeImage.sln" "${solution}")
    message(STATUS "Combined Visual Studio solution: ${output_dir}/FreeImage.sln")
endfunction()
